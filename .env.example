# --- Database (Railway Postgres in production; local dev works too) ---
DATABASE_URL=postgresql://localhost:5432/jobhunt

# --- Aggregated job search (optional; engine skips without one of these) ---
SERPAPI_KEY=
SERPER_API_KEY=

# --- Notifications (optional; digest prints to console without it) ---
RESEND_API_KEY=
NOTIFY_EMAIL=owner@example.com

# --- LLM scoring + tailoring (optional; deterministic fallback without it) ---
# Kimi / Moonshot OpenAI-compatible API
KIMI_API_KEY=
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6

# --- Runtime ---
ENGINE_TZ=America/Los_Angeles
PLAYWRIGHT_HEADLESS=false

# --- Gmail thread tracking (M10; read-only OAuth) ---
# Create an OAuth client at console.cloud.google.com with gmail.readonly scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_PATH=.gmail_token.json
# Designated CC/BCC tracking address (Resend inbound webhook -> `ingest-email`)
RESEND_TRACKING_ADDRESS=track@your-domain.com
